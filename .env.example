# Database Connection String for PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/codemux_db?schema=public"

# JWT Secret for Session Signing
JWT_SECRET="codemux-production-secret-replace-with-secure-32-char-random-string"

# Public Application URL
NEXT_PUBLIC_APP_URL="https://cod-mux-website.vercel.app"

# Source Protection (Right-click & DevTools inspection disabled only when enabled or in production)
NEXT_PUBLIC_ENABLE_SOURCE_PROTECTION="false"
