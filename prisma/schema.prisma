generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  enrollments        Enrollment[]
  id                 Int                        @id @default(autoincrement())
  email              String                     @unique
  passwordHash       String
  name               String
  role               Role                       @default(STUDENT)
  phone              String?
  age                Int?
  track              String?
  batch              String?
  status             UserStatus                 @default(ACTIVE)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  createdAnnounce    Announcement[]             @relation("CreatedAnnouncements")
  attendanceRecords  AttendanceRecord[]
  issuedCertificates CertificateRecord[]        @relation("StudentCertificates")
  mentorClasses      ClassSchedule[]            @relation("MentorClasses")
  projectSubmissions StudentProjectSubmission[]

  @@index([email])
  @@index([role])
}

model ClassSchedule {
  id           Int                @id @default(autoincrement())
  track        String
  batch        String
  topic        String
  description  String?
  mentorId     Int
  date         DateTime
  timeSlot     String
  roomLink     String
  pptTitle     String?
  pptUrl       String?
  recordingUrl String?
  status       ClassStatus        @default(UPCOMING)
  createdAt    DateTime           @default(now())
  attendance   AttendanceRecord[]
  mentor       User               @relation("MentorClasses", fields: [mentorId], references: [id])

  @@index([track, batch])
  @@index([date])
}

model AttendanceRecord {
  id        Int              @id @default(autoincrement())
  classId   Int
  studentId Int
  status    AttendanceStatus @default(PRESENT)
  markedBy  String
  remarks   String?
  markedAt  DateTime         @default(now())
  class     ClassSchedule    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

model Project {
  id                 Int                        @id @default(autoincrement())
  track              String
  title              String
  description        String
  difficulty         ProjectDifficulty          @default(INTERMEDIATE)
  deadline           DateTime?
  deliverables       String[]
  evaluationCriteria String[]
  starterCodeUrl     String?
  createdAt          DateTime                   @default(now())
  submissions        StudentProjectSubmission[]

  @@index([track])
}

model StudentProjectSubmission {
  id          Int              @id @default(autoincrement())
  projectId   Int
  studentId   Int
  githubUrl   String
  liveDemoUrl String?
  notes       String?
  status      SubmissionStatus @default(PENDING_REVIEW)
  grade       String?
  feedback    String?
  reviewedBy  String?
  reviewedAt  DateTime?
  submittedAt DateTime         @default(now())
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([projectId])
}

model CertificateRecord {
  id                      Int                   @id @default(autoincrement())
  certificateSerialNumber String                @unique
  studentId               Int
  studentNameSnapshot     String
  courseId                String
  courseNameSnapshot      String
  instructorNameSnapshot  String
  courseDurationSnapshot  String                @default("60 Days")
  enrollmentDate          String
  completionDate          String
  issueDate               String
  certificateStatus       CertificateStatus     @default(ACTIVE)
  templateVersion         String                @default("v1.0")
  issuedBy                String                @default("admin@codemux.in")
  revokedReason           String?
  revokedAt               DateTime?
  revokedBy               String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  auditLogs               CertificateAuditLog[]
  student                 User                  @relation("StudentCertificates", fields: [studentId], references: [id])

  @@index([certificateSerialNumber])
  @@index([studentId])
}

model CertificateAuditLog {
  id                      Int               @id @default(autoincrement())
  certificateSerialNumber String
  action                  String
  performedBy             String
  details                 String
  reason                  String?
  timestamp               DateTime          @default(now())
  certificate             CertificateRecord @relation(fields: [certificateSerialNumber], references: [certificateSerialNumber], onDelete: Cascade)

  @@index([certificateSerialNumber])
}

model EarlyAccessLead {
  id          Int        @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  interest    String
  status      LeadStatus @default(PENDING)
  submittedAt DateTime   @default(now())

  @@index([email])
}

model ContactInquiry {
  id          Int           @id @default(autoincrement())
  name        String
  email       String
  subject     String
  interest    String
  message     String
  status      InquiryStatus @default(NEW)
  submittedAt DateTime      @default(now())
}

model Announcement {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  targetRole String   @default("ALL")
  creatorId  Int
  createdAt  DateTime @default(now())
  creator    User     @relation("CreatedAnnouncements", fields: [creatorId], references: [id])
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ClassStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ProjectDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  NEEDS_CHANGES
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

enum LeadStatus {
  PENDING
  CONTACTED
  ENROLLED
}

enum InquiryStatus {
  NEW
  RESPONDED
}

enum EnrollmentStatus {
  ACTIVE
  PENDING
  COMPLETED
  CANCELLED
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]

  @@index([title])
  @@index([isActive])
}

model Enrollment {
  id             Int              @id @default(autoincrement())
  studentId      Int
  courseId       Int
  status         EnrollmentStatus @default(ACTIVE)
  purchaseAmount Decimal?         @db.Decimal(10, 2)
  enrolledAt     DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
}
